# Dependencies
node_modules/

# Build output
dist/
build/
# TanStack Router plugin scratch dir. routeTree.gen.ts IS tracked — it is
# generated but the app imports it, so a clean checkout has to build.
.tanstack/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Environment — never commit secrets. .env.example is the tracked template.
.env
.env.*
!.env.example

# Azure Functions local settings — holds the SQL connection string and, in
# some local setups, a connection secret. local.settings.json.example is the
# tracked template, same pattern as .env.example above.
server/local.settings.json

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Test / coverage output
coverage/
*.log
