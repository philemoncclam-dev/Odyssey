{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",

    /* Correctness. `strict` was never set in the project this was ported from,
       despite its docs claiming otherwise — so the guarantee was never
       enforced. Turning it on cost zero errors: the code was already written
       to the standard, it just was not held to it.

       `noUncheckedIndexedAccess` is deliberately NOT on yet. It is the right
       setting for a tool that indexes records and arrays constantly, but it
       reports 118 sites, which would bury the port it landed with. It gets
       its own PR. */
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true
  },
  "include": ["src"]
}
